  npcIcon: {fileID: 21300000, guid: aca088a57710e744eb1be9613785722c, type: 3}
  dialogue:
  - "\u62D0\u6756...\uFF1F\u6211\u4E0D\u6E05\u695A..."
  - "\u4E0D\u904E\u5728\u6211\u5011\u6751\u838A\uFF0C\u60C5\u5831\u5171\u901A\u662F\u5F88\u91CD\u8981\u7684..."
  - "\u53EA\u8981\u6709\u91CD\u8981\u4E8B\u9805\uFF0C\u7D55\u5C0D\u6703\u8CBC\u5728\u6751\u5167\u7684\u516C\u4F48\u6B04\u4E0A"
  - "\u5931\u7269\u62DB\u9818\uFF0C\u91CD\u8981\u4E8B\u9805\uFF0C\u751A\u81F3\u6751\u5167\u6709\u4EBA\u7D50\u5A5A\u4E5F\u6703\u5728\u516C\u4F48\u6B04\u544A\u77E5\u54E6\u3002\u9019\u662F\u6211\u5011\u6751\u838A\u7684\u50B3\u7D71"
  - "\u8AAA\u4E0D\u5B9A\u4F60\u53EF\u4EE5\u5230\u90A3\u908A\u627E\u627E\u770B...\u55DA\u55DA...\u5C0D\u4E0D\u8D77\u6211\u6D3E\u4E0D\u4E0A\u4EFB\u4F55\u7528\u9014..."
