  m_Name: "\u67D3\u6599\u5546\u4EBA_\u9592\u804A"
  m_EditorClassIdentifier: 
  npcIcon: {fileID: 0}
  dialogue:
  - "\u6B61\u8FCE\u4F86\u770B\u770B\uFF01\u6211\u9019\u908A\u7684\u67D3\u6599\u90FD\u662F\u7D55\u54C1\u54E6\uFF01\u4FDD\u8B49\u67D3\u4E86\u7D55\u5C0D\u4E0D\u6389\u8272\u54E6\uFF01"
  - "\u4F60\u4E5F\u60F3\u8981\u4F86\u9EDE\u55CE\uFF1F\u4E0D\u904E\u53EF\u60DC\u6211\u9019\u908A\u7684\u6750\u6599\u5DF2\u7D93\u5FEB\u8981\u7528\u5B8C\u4E86"
  - "\u5982\u679C\u4F60\u9858\u610F\u5E6B\u6211\u63A1\u4E00\u4E9B\u73FE\u8CA8\u7684\u8A71\uFF0C\u6211\u53EF\u4EE5\u628A\u624B\u908A\u7684\u6700\u5F8C\u4E00\u74F6\u67D3\u6599\u7D66\u4F60"
  playertalk: 000000
  responses:
  - responseText: "\u9EDE\u982D"
