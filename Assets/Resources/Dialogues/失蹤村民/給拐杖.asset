  npcIcon: {fileID: 21300000, guid: 1569dba0ffa1ef140bce4a65a9674743, type: 3}
  dialogue:
  - "\u55DA\u55DA\u55DA...\u662F\u4F60\u628A\u6211\u6551\u51FA\u4F86\u7684\u55CE...\uFF1F\u770B\u4F86\u4F60\u4E5F\u662F\u60F3\u8981\u9003\u96E2\u9019\u500B\u6751\u838A\u7684\u5427..."
  - "\u90A3\u500B\u97F3\u6A02\u82B1\u7684\u50B3\u805E\u6839\u672C\u662F\u500B\u9677\u9631...\u6F14\u594F\u51FA\u4F86\u53EA\u6703\u548C\u6211\u843D\u5230\u76F8\u540C\u7684\u4E0B\u5834...\u55DA\u55DA...\u6211\u73FE\u5728\u53EA\u60F3\u56DE\u5BB6"
  - "\u4F60\u60F3\u8981\u9019\u500B\u62D0\u6756...\uFF1F\u7D66\u4F60\u5427\u6211\u5DF2\u7D93\u4E0D\u9700\u8981\u4E86...\u55DA\u55DA\u55DA......"
