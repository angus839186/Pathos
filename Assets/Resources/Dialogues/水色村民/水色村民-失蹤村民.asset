  m_Script: {fileID: 11500000, guid: e1dacdf748729db4f8f500ed08e5ca8e, type: 3}
  m_Name: "\u6C34\u8272\u6751\u6C11-\u5931\u8E64\u6751\u6C11"
  m_EditorClassIdentifier: 
  npcIcon: {fileID: 0}
  dialogue:
  - "\u54E6\u54E6\uFF0C\u537B\u6700\u8FD1\u6C92\u4EC0\u9EBC\u770B\u904E\u4ED6"
  - "\u4E0D\u904E\u4F60\u77E5\u9053\u6751\u838A\u4E0D\u53EF\u601D\u8B70\u7684\u97F3\u6A02\u82B1\u50B3\u8AAA\u55CE\uFF1F\u64DA\u8AAA\u53EA\u8981\u5229\u7528\u97F3\u6A02\u82B1\u6F14\u594F\u4E86\u5C0D\u61C9\u7684\u97F3\u6A02\uFF0C\u5C31\u53EF\u4EE5\u5F9E\u5225\u7684\u51FA\u53E3\u96E2\u958B\u6751\u838A\u5230\u5916\u982D\u54E6\u3002"
  - "\u6211\u539F\u672C\u4E5F\u4E0D\u600E\u9EBC\u76F8\u4FE1\uFF0C\u662F\u90A3\u50A2\u4F19\u4E00\u5929\u5230\u5C3E\u5C0D\u6211\u8AAA\u9019\u4EF6\u4E8B\uFF0C\u6211\u8A18\u5F97\u4E0A\u6B21\u6700\u5F8C\u4E00\u6B21\u78B0\u5230\u4ED6\u597D\u50CF\u662F\u8AAA\u8981\u53BB\u5BE6\u884C\u770B\u770B"
  - "\u6216\u8A31\u8DDF\u97F3\u6A02\u82B1\u76F8\u95DC\u7684\u4E8B\u4F60\u53EF\u4EE5\u548C\u9019\u500B\u6751\u838A\u7684\u6A02\u624B\u554F\u554F\u770B\uFF0C\u4ED6\u5C31\u4F4F\u5728\u9644\u8FD1\u800C\u5DF2"
  playertalk: 00000000
  responses:
  - responseText: "\u597D"
    dialogueObject: {fileID: 0}
