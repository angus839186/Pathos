  dialogue:
  - "(\u9019\u672C\u66F8\u4E0A\u982D\u5BEB\u8457\uFF0C\u6751\u838A\u4E0D\u53EF\u601D\u8B70)"
  - "\u300E\u591C\u665A\u7684\u8840\u4E4B\u5E7D\u9748\uFF01\uFF1F\u53EA\u8981\u5728\u534A\u591C\u5230\u6C89\u5E7D\u7C73\u68EE\u6797\uFF0C\u64DA\u8AAA\u5C31\u6709\u6A5F\u7387\u52DF\u96C6\u5230\u6EFF\u8EAB\u662F\u8840\u7684\u5E7D\u9748\uFF0C\u4E26\u4E14\u6703\u5728\u5468\u570D\u807D\u898B\u54C0\u865F\u8072\uFF01\u300F"
  - "\u300E\u97F3\u6A02\u82B1\u50B3\u8AAA\uFF01\u50B3\u8AAA\u53EA\u8981\u6F14\u594F\u51FA\u5C0D\u61C9\u7684\u97F3\u6A02\uFF0C\u5C31\u6703\u53D7\u5230\u97F3\u6A02\u4E4B\u795E\u7684\u7737\u9867......\u300F"
  - "(\u4EE5\u4E0B\u9801\u9762\u88AB\u5176\u4ED6\u4EBA\u7D66\u6495\u6389\u4E86\u7684\u6A23\u5B50)"
