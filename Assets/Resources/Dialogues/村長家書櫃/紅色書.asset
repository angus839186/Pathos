  m_Script: {fileID: 11500000, guid: e1dacdf748729db4f8f500ed08e5ca8e, type: 3}
  m_Name: "\u7D05\u8272\u66F8"
  m_EditorClassIdentifier: 
  npcIcon: {fileID: 0}
  dialogue:
  - "(\u9019\u672C\u66F8\u4E0A\u4ECB\u7D39\u8457\u5404\u5F0F\u5404\u6A23\u7684\u52D5\u690D\u7269)"
  - "\u300E\u6F3F\u679C\u6A39\uFF0C\u5750\u843D\u65BC\u7C73\u6C99\u742A\u746A\u4E18\u9675\u7684\u690D\u7269\u3002\u4E0A\u982D\u7684\u6F3F\u679C\u4EE5\u9BAE\u8C54\u7684\u984F\u8272\u8457\u540D\uFF0C\u6709\u76F8\u7576\u5F37\u5927\u7684\u67D3\u8272\u80FD\u529B\u3002\u5982\u679C\u4E0D\u597D\u597D\u8655\u7406\uFF0C\u88AB\u67D3\u8272\u7684\u90E8\u5206\u9700\u8981\u82B1\u76F8\u7576\u5927\u7684\u529F\u592B\u6E05\u7406\u3002\u67D3\u8272\u7684\u6548\u679C\u5F77\u5F7F\u672C\u8EAB\u5C31\u5E36\u6709\u90A3\u500B\u984F\u8272\u4E00\u822C\uFF0C\u5E38\u88AB\u67D3\u6599\u5546\u4EBA\u62FF\u4F86\u52A0\u5DE5\u3002\u300F"
  - "\u300E\u7C73\u6C99\u742A\u746A\u4E18\u9675\u8457\u540D\u7684\u52D5\u7269\u70BA\u7F8A\u7FA4\uFF0C\u8EDF\u7DBF\u7DBF\u7684\u5916\u89C0\u70BA\u5176\u7279\u5FB5\u3002\u807D\u8AAA\u5076\u723E\u6703\u6709\u5E7E\u96BB\u7D05\u8272\u7684\u7F8A\u7FA4\u70BA\u7A00\u6709\u7269\u7A2E\uFF0C\u4E0D\u904E\u9019\u4E9B\u7D05\u8272\u7684\u7F8A\u4E26\u4E0D\u5E36\u6709\u907A\u50B3\u7279\u6027\uFF0C\u9019\u9EDE\u8B93\u4EBA\u975E\u5E38\u611F\u8208\u8DA3......\u300F"
  - "\u300E\u97F3\u6A02\u82B1\uFF0C\u4F4D\u65BC\u6C89\u5E7D\u7C73\u68EE\u6797\u5167\u7684\u690D\u7269\u3002\u5916\u578B\u70BA\u91D1\u9EC3\u8272\u7684\u5927\u578B\u82B1\u7A2E\u3002\u4E4B\u6240\u4EE5\u6703\u88AB\u9019\u6A23\u547D\u540D\u7684\u539F\u56E0\u662F\u56E0\u70BA\u6416\u6643\u4ED6\u6703\u767C\u51FA\u7368\u7279\u7684\u97F3\u8272\u3002\u96A8\u8457\u4E0D\u540C\u5916\u5F62\u4E5F\u6703\u97FF\u51FA\u4E0D\u540C\u97F3\u8272\u3002\u6709\u4E0D\u5C11\u97F3\u6A02\u5BB6\u4E5F\u5617\u8A66\u8457\u7814\u7A76\u5176\u4E2D\u7684\u5967\u5999\u3002\u300F"
  playertalk: 01010101
  responses: []
